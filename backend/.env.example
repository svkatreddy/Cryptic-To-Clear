# Port the Express server listens on
PORT=5000

# Standard Node environment flag ("development" or "production")
NODE_ENV=development

# Origin allowed to call this API (your Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# --- Judge0 connection -------------------------------------------------
# Option A — RapidAPI's hosted Judge0 CE (easiest to start with):
#   1. Subscribe at https://rapidapi.com/judge0-official/api/judge0-ce
#   2. Copy your RapidAPI key below.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Option B — a self-hosted Judge0 CE instance:
#   Set JUDGE0_API_URL to your instance's base URL and leave
#   JUDGE0_API_KEY empty (no RapidAPI headers will be sent).
# JUDGE0_API_URL=http://localhost:2358

# Max time (ms) to wait for Judge0's synchronous response
JUDGE0_TIMEOUT_MS=20000

# --- AI provider configuration ------------------------------------------
# Primary provider: NVIDIA
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=30000

# Fallback provider: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_BASE_URL=https://api.generativeai.google/v1
GEMINI_TIMEOUT_MS=30000

# Deprecated provider removed: GROQ support is no longer used.

